<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notificationsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_bg">

    <LinearLayout
        android:id="@+id/notificationsTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md_bg"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_3"
            android:src="@drawable/ic_back"
            android:tint="@color/md_text"
            android:contentDescription="@string/action_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_3"
            android:text="@string/nav_notifications"
            android:textAppearance="@style/TextAppearance.Maduka.H3" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_divider" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/notificationsContainer"
        android:name="com.maduka.rentmanager.ui.admin.notifications.AdminNotificationsFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
