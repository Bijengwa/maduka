<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_bg">

    <LinearLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md_bg"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_3">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_3"
            android:src="@drawable/ic_back"
            android:tint="@color/md_text"
            android:contentDescription="@string/action_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_3"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Maduka.H3" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_4">

        <LinearLayout
            android:id="@+id/rowChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_password"
                android:tint="@color/md_text"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                android:text="@string/settings_change_password"
                android:textAppearance="@style/TextAppearance.Maduka.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="@color/md_neutral_400" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/space_6"
            android:layout_marginEnd="@dimen/space_6"
            android:background="@color/md_divider" />

        <LinearLayout
            android:id="@+id/rowSignOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sign_out"
                android:tint="@color/md_status_bad_fg"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_4"
                android:text="@string/settings_sign_out"
                android:textColor="@color/md_status_bad_fg"
                android:textAppearance="@style/TextAppearance.Maduka.Body" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
