<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingTop="@dimen/space_6">

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Maduka.Small" />

        <!-- Stat grid: Units / Occupied / Empty / Overdue, real values only. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardUnits"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shops_stat_units" android:textAppearance="@style/TextAppearance.Maduka.Caption" />
                <TextView android:id="@+id/tvStatUnits" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.H2" />
                <TextView android:id="@+id/tvStatUnitsSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.Small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardOccupied"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_2"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shops_stat_occupied" android:textAppearance="@style/TextAppearance.Maduka.Caption" />
                <TextView android:id="@+id/tvStatOccupied" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.H2" android:textColor="@color/md_status_good_fg" />
                <TextView android:id="@+id/tvStatOccupiedSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.Small" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardEmpty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shops_stat_empty" android:textAppearance="@style/TextAppearance.Maduka.Caption" />
                <TextView android:id="@+id/tvStatEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.H2" android:textColor="@color/md_neutral_400" />
                <TextView android:id="@+id/tvStatEmptySub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.Small" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardOverdue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_2"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_4">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/shops_stat_overdue" android:textAppearance="@style/TextAppearance.Maduka.Caption" />
                <TextView android:id="@+id/tvStatOverdue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.H2" android:textColor="@color/md_status_bad_fg" />
                <TextView android:id="@+id/tvStatOverdueSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.Maduka.Small" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter chips: All / Occupied / Empty / Overdue -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    style="@style/MadukaFilterChip"
                    android:text="@string/shops_filter_all" />

                <TextView
                    android:id="@+id/filterOccupied"
                    style="@style/MadukaFilterChip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shops_filter_occupied" />

                <TextView
                    android:id="@+id/filterEmpty"
                    style="@style/MadukaFilterChip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shops_filter_empty" />

                <TextView
                    android:id="@+id/filterOverdue"
                    style="@style/MadukaFilterChip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shops_filter_overdue" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerShops"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="88dp"
            android:visibility="gone"
            tools:listitem="@layout/item_shop_card" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/properties_empty"
            android:textAppearance="@style/TextAppearance.Maduka.Body"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAddShop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/space_6"
            android:background="@drawable/bg_button_primary"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_3"
            android:textAllCaps="false"
            android:textColor="@color/md_bg"
            android:textSize="16sp"
            android:text="@string/properties_add_shop"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

