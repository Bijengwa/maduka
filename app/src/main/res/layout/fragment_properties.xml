<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingTop="@dimen/space_6">

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Maduka.Small" />

        <!-- Filter chips: All / Occupied / Empty / Overdue -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    style="@style/MadukaFilterChip"
                    android:text="@string/shops_filter_all" />

                <TextView
                    android:id="@+id/filterOccupied"
                    style="@style/MadukaFilterChip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shops_filter_occupied" />

                <TextView
                    android:id="@+id/filterEmpty"
                    style="@style/MadukaFilterChip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shops_filter_empty" />

                <TextView
                    android:id="@+id/filterOverdue"
                    style="@style/MadukaFilterChip"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/shops_filter_overdue" />
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerShops"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="80dp"
            android:visibility="gone"
            tools:listitem="@layout/item_shop_card" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/properties_empty"
            android:textAppearance="@style/TextAppearance.Maduka.Body"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnAddShop"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_6"
            android:background="@drawable/bg_fab_circle"
            android:src="@drawable/ic_properties"
            android:tint="@color/md_bg"
            android:padding="@dimen/space_4"
            android:elevation="6dp"
            android:contentDescription="@string/properties_add_shop"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

