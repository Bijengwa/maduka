<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/md_surface"
    android:padding="@dimen/space_8">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/properties_add_shop"
        android:textAppearance="@style/TextAppearance.Maduka.H3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/properties_shop_id_label"
        android:textAppearance="@style/TextAppearance.Maduka.Caption" />

    <Spinner
        android:id="@+id/spinnerShopId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_card"
        android:padding="@dimen/space_3" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRent"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:hint="@string/properties_rent_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etRent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvAllRegistered"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/properties_all_shops_registered"
        android:textAppearance="@style/TextAppearance.Maduka.Body"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:background="@drawable/bg_button_primary"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_3"
        android:textAllCaps="false"
        android:textColor="@color/md_bg"
        android:textSize="16sp"
        android:text="@string/properties_add_action" />

</LinearLayout>
