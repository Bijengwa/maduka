<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Maduka" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/md_bg</item>
        <item name="colorPrimary">@color/md_accent</item>
        <item name="colorPrimaryDark">@color/md_bg</item>
        <item name="colorAccent">@color/md_accent_2</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_text</item>
        <item name="colorOnPrimary">@color/md_bg</item>
        <item name="android:textColorPrimary">@color/md_text</item>
        <item name="android:textColor">@color/md_text</item>
        <item name="android:statusBarColor">@color/md_bg</item>
        <item name="android:navigationBarColor">@color/md_bg</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="alertDialogTheme">@style/Theme.Maduka.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.Maduka.DatePicker</item>
    </style>

    <!-- Calendar dialog: dark surface with the purple accent instead of the stock grey header. -->
    <style name="Theme.Maduka.DatePicker" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/md_accent_600</item>
        <item name="android:colorControlActivated">@color/md_accent_600</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/md_text</item>
        <item name="android:textColorSecondary">@color/md_neutral_400</item>
        <item name="android:textColorPrimaryInverse">@color/md_text</item>
        <item name="android:datePickerStyle">@style/Widget.Maduka.DatePicker</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Maduka.DialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.Maduka.DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.Maduka.DialogButton</item>
    </style>

    <style name="Widget.Maduka.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/md_accent_300</item>
    </style>

    <style name="Widget.Maduka.DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/md_accent_700</item>
    </style>

    <!-- Dark, rounded dialogs that match the cards instead of the stock grey Material dialog. -->
    <style name="Theme.Maduka.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorPrimary">@color/md_accent_300</item>
        <item name="colorAccent">@color/md_accent_300</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_text</item>
        <item name="android:textColorPrimary">@color/md_text</item>
        <item name="android:textColorSecondary">@color/md_neutral_400</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- Type scale: sizes/weights from the design-tokens decision. Each style
         points at the specific static Inter weight file directly (not the
         combined font-family) since per-weight selection via fontWeight
         needs API 28+ and minSdk here is 24. -->
    <style name="TextAppearance.Maduka.H1" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/md_text</item>
    </style>
    <style name="TextAppearance.Maduka.H2" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/md_text</item>
    </style>
    <style name="TextAppearance.Maduka.H3" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/md_text</item>
    </style>
    <style name="TextAppearance.Maduka.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_text</item>
    </style>
    <style name="TextAppearance.Maduka.Small" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/md_neutral_400</item>
    </style>
    <style name="TextAppearance.Maduka.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/md_neutral_400</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Reusable filter-chip look (Shops/Tenants filter rows): unselected by default via
         shape_pill_unselected; toggled to shape_pill_selected + accent text color in code. -->
    <style name="MadukaFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_pill_unselected</item>
        <item name="android:paddingStart">@dimen/space_4</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="android:paddingTop">@dimen/space_2</item>
        <item name="android:paddingBottom">@dimen/space_2</item>
        <item name="android:textAppearance">@style/TextAppearance.Maduka.Small</item>
        <item name="android:textColor">@color/md_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>

