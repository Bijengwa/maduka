{
  "rules": {
    ".read": false,
    ".write": false,

    "super_admins": {
      ".read": "auth != null && root.child('super_admins').child(auth.uid).exists()",
      ".write": false
    },

    "admins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('super_admins').child(auth.uid).exists())",
      ".write": "auth != null && root.child('super_admins').child(auth.uid).exists()"
    },

    "tenants": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('super_admins').child(auth.uid).exists())",
      ".write": "auth != null && root.child('super_admins').child(auth.uid).exists()",
      "$tenantUid": {
        ".read": "auth != null && auth.uid === $tenantUid"
      }
    },

    "shops": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('super_admins').child(auth.uid).exists())",
      ".write": "auth != null && root.child('super_admins').child(auth.uid).exists()",
      "$shopId": {
        ".read": "auth != null && data.child('tenantUid').val() === auth.uid"
      }
    },

    "payments": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('super_admins').child(auth.uid).exists() || (query.orderByChild == 'tenantUid' && query.equalTo == auth.uid))",
      ".write": "auth != null && root.child('super_admins').child(auth.uid).exists()",
      ".indexOn": ["tenantUid"]
    },

    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('super_admins').child(auth.uid).exists())"
      }
    },

    "login_index": {
      "$role": {
        "$key": {
          ".read": true
        }
      },
      ".write": "auth != null && root.child('super_admins').child(auth.uid).exists()"
    }
  }
}
